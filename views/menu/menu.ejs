<% layout("/layouts/boilerplate") %>
<style>
body {
    background: #fff;
    font-family: Arial, sans-serif;
}
.menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem;
    border-bottom: 1px solid #ddd;
}
.menu-header h4 {
    margin: 0;
    color: #fe424d;
    font-weight: bold;
}
.menu-links {
    display: flex;
    flex-direction: column;
    padding: 1rem;
    gap: 1rem;
}
.menu-links a {
    text-decoration: none;
    font-size: 1.2rem;
    font-weight: 500;
    color: #222;
}
.menu-links a:hover {
    color: #fe424d;
}
</style>


